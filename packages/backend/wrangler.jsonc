{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-22",
	"assets": {
		"binding": "ASSETS",
		"directory": "../frontend/dist"
	},
	"routes": [{ "pattern": "hattori-dev.com", "custom_domain": true }],
	"workers_dev": false
